          ],
          "port": "3000",
          "path": [
            "api",
            "heroes"
          ]
        },
        "description": "POST /api/heroes\nHasil yang benar: 201, id 134",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Collie\",\n  \"role\": \"MAGE\",\n  \"lane\": \"MID\",\n  \"releaseYear\": 2026,\n  \"priceBP\": 32000,\n  \"priceDiamond\": 599\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
