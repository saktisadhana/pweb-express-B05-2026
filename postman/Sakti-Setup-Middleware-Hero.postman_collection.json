{
  "info": {
    "name": "MLBB Shop - Sakti (Setup, Middleware, Hero)",
    "description": "Bagian Sakti saja: testcase resmi 01-08 dan 28, ditambah assertion Postman. Jalankan seed ulang sebelum collection; seed menghapus semua data. Fitur 3-7 dikerjakan anggota lain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "health"
          ]
        },
        "description": "GET /health\nHasil yang benar: 200"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response envelope\", function () { const body = pm.response.json(); pm.expect(body.status).to.eql(true); pm.expect(body.message).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Daftar Hero Role Marksman",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/heroes?role=MARKSMAN&limit=5",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "heroes"
          ],
          "query": [
            {
              "key": "role",
              "value": "MARKSMAN"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "GET /api/heroes?role=MARKSMAN&limit=5\nHasil yang benar: 200, totalItems 20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response envelope\", function () { const body = pm.response.json(); pm.expect(body.status).to.eql(true); pm.expect(body.message).to.be.a(\"string\"); });",
              "pm.test(\"Filtered total\", function () { pm.expect(pm.response.json().metadata.totalItems).to.eql(20); });"
            ]
          }
        }
      ]
    },
