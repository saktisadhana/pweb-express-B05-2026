  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "vitest": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
